{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account settings and profile details",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "The user's display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "The user's registered email"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar photo URL"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "description": "Selected theme mode"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat thread containing multiple turns",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Title or summary of conversation"
        },
        "model": {
          "type": "string",
          "maxLength": 100,
          "description": "The primary Gemini model used"
        },
        "mode": {
          "type": "string",
          "maxLength": 50,
          "description": "Conversation mode (general, thinking, fast, search, maps, image, science)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when conversation began"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent activity"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single prompt or response turn in a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID"
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Sender UID or owner UID"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model", "system"],
          "description": "Message role"
        },
        "content": {
          "type": "string",
          "maxLength": 50000,
          "description": "Text content of the message"
        },
        "model": {
          "type": "string",
          "maxLength": 100,
          "description": "Model used for model turns"
        },
        "mode": {
          "type": "string",
          "maxLength": 50,
          "description": "Mode of the turn"
        },
        "imageUri": {
          "type": "string",
          "maxLength": 5000,
          "description": "Optional generated image or uploaded image"
        },
        "thinkingProcess": {
          "type": "string",
          "maxLength": 50000,
          "description": "Model internal reasoning thinking trace"
        },
        "attachments": {
          "type": "array",
          "description": "List of user-uploaded media attachments metadata with lightweight thumbnail"
        },
        "groundingLinks": {
          "type": "array",
          "description": "Grounding links or references returned by tools"
        },
        "audioUri": {
          "type": "string",
          "maxLength": 50000,
          "description": "Generated speech audio data URI or URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp message was sent"
        }
      },
      "required": ["id", "conversationId", "userId", "role", "content", "createdAt"]
    },
    "LibraryItem": {
      "title": "LibraryItem",
      "description": "Saved image asset or archived conversation snapshot persisted in Maria Library",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": ["images", "documents", "audio", "bookmarked", "chat-history", "archive", "formulas"],
          "maxLength": 40
        },
        "kind": {
          "type": "string",
          "enum": ["image", "chat", "note"],
          "maxLength": 20
        },
        "type": {
          "type": "string",
          "maxLength": 100
        },
        "date": {
          "type": "string",
          "maxLength": 60
        },
        "size": {
          "type": "string",
          "maxLength": 40
        },
        "previewUrl": {
          "type": "string",
          "maxLength": 220000
        },
        "imageMediaKey": {
          "type": "string",
          "maxLength": 128
        },
        "snippet": {
          "type": "string",
          "maxLength": 1000
        },
        "badge": {
          "type": "string",
          "maxLength": 50
        },
        "sourceConvId": {
          "type": "string",
          "maxLength": 128
        },
        "sourceMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "maxLength": 100
        },
        "mode": {
          "type": "string",
          "maxLength": 50
        },
        "archivedMessages": {
          "type": "array",
          "maxItems": 200
        },
        "createdAtIso": {
          "type": "string",
          "maxLength": 60
        },
        "updatedAtIso": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "category", "kind", "type", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile records"
    },
    "/users/{userId}/library/{itemId}": {
      "schema": "LibraryItem",
      "description": "Persistent user library assets (saved images and full archived chat snapshots)"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversations stored per user"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages within a conversation"
    }
  }
}
